# === EcoConcept site — переменные окружения ===
# Скопируйте в .env (локально) или добавьте в Vercel → Project → Settings → Environment Variables

# PostgreSQL (Neon): строка подключения из neon.tech, с ?sslmode=require
DATABASE_URI=postgres://user:password@host.neon.tech/ecoconcept?sslmode=require

# Секрет Payload (любая длинная случайная строка, сгенерируйте новую для продакшена)
PAYLOAD_SECRET=change-me-to-long-random-string

# Публичный адрес сайта (для sitemap, robots, OG)
SITE_URL=https://your-domain.kg

# Входящий вебхук Битрикс24 (Разработчикам → Другое → Входящий вебхук, права CRM)
# Формат: https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxx
B24_WEBHOOK_URL=

# Vercel Blob (создаётся в Vercel → Storage → Blob → Connect to project)
BLOB_READ_WRITE_TOKEN=

# 🔒 Закупочные цены и формула розницы. В исходниках их нет — только здесь и в
# переменных окружения Vercel. Формат:
# {"fx":88,"markup":2.7,"installKgs":90000,"fancoilUsd":258,"exw":{"phnix-g20":1210, ...}}
# Без этой переменной сайт работает, но цену «под ключ» не показывает.
PURCHASE_PRICES=
